# Public reference only. Keep the existing encrypted database and secret .env.
# These are the tested local Bridge settings, not a replacement for the live env.
MITM_LOCAL_PORT=8443
MITM_TARGET_AGENT=claude-code
MITM_SELECTED_ONLY=true
MITM_AUTO_RECOVER=true

# Replace this example path with the existing absolute DATA_DIR shim path.
# Never disable certificate verification to resolve a routing problem.
NODE_OPTIONS=--require=/absolute/path/to/data/bridge-upstream-dns.cjs
