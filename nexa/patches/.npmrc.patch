diff --git a/.npmrc b/.npmrc
index c6dba7326..745be217d 100644
--- a/.npmrc
+++ b/.npmrc
@@ -12,3 +12,19 @@ fetch-retries=5
 fetch-retry-factor=4
 fetch-retry-mintimeout=20000
 fetch-retry-maxtimeout=120000
+
+# npm 11.16 blocks package lifecycle scripts unless they are allowlisted
+# (`allow-scripts` defaults to empty, `dangerously-allow-all-scripts=false`).
+# That silently broke the Docker image build: `npm rebuild better-sqlite3`
+# reported "rebuilt dependencies successfully" while warning that 14 packages
+# had their install scripts blocked, so better_sqlite3.node was never compiled
+# and the very next line — `require('better-sqlite3')` — died with
+# "Could not locate the bindings file". The failure stayed hidden while the
+# npm-ci layer was cached and only surfaced once the builder cache was pruned.
+#
+# ONLY better-sqlite3 is allowed: it is the one dependency that must compile
+# from source here. sharp (@img), @ngrok, koffi and onnxruntime-node also ship
+# .node binaries but get them from prebuilt, platform-specific optional
+# packages that need no script — verified against the last good image. Keep
+# this list minimal; do NOT reach for dangerously-allow-all-scripts.
+allow-scripts[]=better-sqlite3
