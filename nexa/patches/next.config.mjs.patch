+const scriptSrc = isProdBuild
+  ? "script-src 'self' 'unsafe-inline' blob: https://static.cloudflareinsights.com"
+  : "script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://static.cloudflareinsights.com";
