@@ -60,6 +60,15 @@ const QUOTA_PATTERNS: ReadonlyArray<RegExp> = [
   /enable overages/i,
   /INSUFFICIENT_G1_CREDITS_BALANCE/i,
 
+  // Anthropic subscription (Claude Code / Max) extra-usage exhaustion:
