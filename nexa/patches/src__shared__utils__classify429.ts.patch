+  /out of extra usage/i,
+  /claude\.ai\/settings\/usage/i,
+
   // Google APIs return this generic RESOURCE_EXHAUSTED message when a
   // billing-period quota has been consumed. Keep the reset-window qualifier
   // so transient Google rate limits are not treated as long-term exhaustion.
@@ -335,6 +344,15 @@ export function classify429(response: {
   if (text && TERMINAL_QUOTA_PATTERNS.some((pat) => pat.test(text))) {
     return "quota_exhausted";
   }
+  // A quota cap does not always arrive as 429. Anthropic reports subscription
+  // extra-usage exhaustion as HTTP 400 ("You're out of extra usage…"), so those
+  // bodies must be scanned too — otherwise the breaker sees `transient`, retries
